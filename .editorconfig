root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.java]
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{xml,sql}]
indent_size = 4

[src/main/resources/db/migration/V1__create_users.sql]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
